# ============================================================
# TradeLynq V2 — Environment Variable Surface
#
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Agents and tooling read this file (names) — never .env.local (values).
#
# Grouped by subsystem. [REQUIRED] must be set for the app to boot in
# production; [REQUIRED-PROD] is asserted at build time in production only;
# everything else degrades gracefully (feature no-ops without its key).
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co   # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                     # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                 # [REQUIRED] SERVER-ONLY — never import into a client component

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000                       # [REQUIRED] prod: https://tradelynq.tech
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin               # prod: https://admin.tradelynq.tech (separate origin, D37)

# ── Rate limiting (Upstash Redis) ───────────────────────────
# https://console.upstash.com — REST API credentials, not the redis:// URL.
# Sensitive limiters (auth, payment) FAIL CLOSED when these are absent:
# the production build asserts their presence and fails without them.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io                # [REQUIRED-PROD]
UPSTASH_REDIS_REST_TOKEN=your-rest-token                        # [REQUIRED-PROD]

# ── Cron authentication ─────────────────────────────────────
# Random 32+ char string. Vercel Cron sends it as: Authorization: Bearer <value>
CRON_SECRET=replace-with-a-random-32-char-string                # [REQUIRED-PROD]

# ── Stripe (recurring subscriptions) ────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...                                   # [REQUIRED-PROD]
STRIPE_WEBHOOK_SECRET=whsec_...                                 # [REQUIRED-PROD] from the webhook endpoint config
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Tier price IDs — the 5 tiers of pricing v3.1 (monthly)
STRIPE_PRICE_PRESENCE=price_...                                 # TTD $200/mo
STRIPE_PRICE_GROWTH=price_...                                   # TTD $700/mo
STRIPE_PRICE_STUDIO=price_...                                   # TTD $1,300/mo
STRIPE_PRICE_PRO=price_...                                      # TTD $2,100/mo
STRIPE_PRICE_ENTERPRISE=price_...                               # TTD $3,500+/mo

# Tier price IDs — annual variants
STRIPE_PRICE_PRESENCE_ANNUAL=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# Crossover account-type items (attached alongside the tier — the crossover engine)
STRIPE_PRICE_ACCT_REGISTERED=price_...                          # TTD $100/mo flat, forever (Registered Business)
STRIPE_PRICE_ACCT_STANDARD=price_...                            # TTD $150/mo from month 7 (unregistered sole trader)

# One-time items
STRIPE_PRICE_REGISTRATION_FEE=price_...                         # TTD $200 one-time
STRIPE_PRICE_REGISTRATION_FEE_STUDENT=price_...                 # TTD $100 one-time (student)

# Tool-credit bundles
STRIPE_PRICE_CREDITS_100=price_...                              # TTD $150 = 100 credits
STRIPE_PRICE_CREDITS_300=price_...                              # TTD $400 = 300 credits
STRIPE_PRICE_CREDITS_1000=price_...                             # TTD $1,000 = 1,000 credits

# ── WiPay (one-time TTD payments — registration, manual renewals) ──
# https://wipayfinancial.com — no recurring billing support
WIPAY_ACCOUNT_NUMBER=your-wipay-account-number
WIPAY_API_KEY=your-wipay-api-key

# ── FAC / First Atlantic Commerce (planned local recurring rail) ──
# Gated on credentials. Callback signature verification is a hard prerequisite
# before this goes live — do not enable without it.
FAC_MERCHANT_ID=your-fac-merchant-id
FAC_MERCHANT_PASSWORD=your-fac-merchant-password
FAC_API_URL=https://marlin.firstatlantic.com/paymentpage/       # sandbox URL during testing

# ── Email (Resend) ──────────────────────────────────────────
# https://resend.com/api-keys — sender domain must have SPF/DKIM verified
RESEND_API_KEY=re_your_api_key                                  # [REQUIRED-PROD]
EMAIL_FROM=TradeLynq <support@tradelynq.tech>
FEEDBACK_RECIPIENT_EMAIL=gregg@tradelynq.tech
FEEDBACK_FROM_EMAIL=feedback@tradelynq.tech
FEEDBACK_FALLBACK_FROM_EMAIL=onboarding@resend.dev
PRELAUNCH_NOTIFY_EMAIL=gregg@tradelynq.tech
ADMIN_EMAIL=gregg@tradelynq.tech

# ── WhatsApp (primary support channel in T&T) ───────────────
# Meta WhatsApp Cloud API. Business-initiated messages need approved templates.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
ADMIN_WHATSAPP_PHONE=1868XXXXXXX                                # internal ops alerts
NEXT_PUBLIC_TRADELYNQ_WHATSAPP=1868XXXXXXX                      # public wa.me deep links

# ── Anthropic (Lynq chatbot + AI tools metered by credits) ──
# https://console.anthropic.com — falls back to a static response without it
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Maps (address autocomplete + storefront map) ─────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-browser-key           # restrict by HTTP referrer

# ── Observability ───────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...                                    # source-map upload at build time (CI only)
SENTRY_ORG=trinovata
SENTRY_PROJECT=tradelynq-v2
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Enterprise webhooks ─────────────────────────────────────
# Master key that encrypts each endpoint's signing secret at rest (AES-256-GCM).
# Exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# ── Misc integrations ───────────────────────────────────────
NEXT_PUBLIC_INSURANCE_REFERRAL_URL=https://partner.example/quote
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...                        # asset upload scripts only

# ── E2E test accounts (CI + local Playwright) ───────────────
# Seeded, disposable accounts — never real user credentials
TEST_CUSTOMER_EMAIL=e2e-customer@tradelynq.test
TEST_CUSTOMER_PASSWORD=
TEST_CUSTOMER_KYC_EMAIL=e2e-customer-kyc@tradelynq.test
TEST_CUSTOMER_KYC_PASSWORD=
TEST_PROFESSIONAL_EMAIL=e2e-professional@tradelynq.test
TEST_PROFESSIONAL_PASSWORD=
TEST_ADMIN_EMAIL=e2e-admin@tradelynq.test
TEST_ADMIN_PASSWORD=
